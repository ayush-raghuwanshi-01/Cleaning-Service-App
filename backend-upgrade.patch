+async def google_auth(session: AsyncSession, credential: str, settings: Settings) -> TokenResponse:
+    """Exchange a Google ID token for a session (sign-in or auto sign-up)."""
+
+    if not settings.google_client_id:
+        raise HTTPException(status_code=status.HTTP_501_NOT_IMPLEMENTED, detail="Google sign-in is not configured")
+
+    try:
+        async with httpx.AsyncClient(timeout=10) as client:
+            resp = await client.get(
+                "https://oauth2.googleapis.com/tokeninfo", params={"id_token": credential}
+            )
+        info = resp.json() if resp.status_code == 200 else {}
+    except httpx.HTTPError as exc:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Could not verify Google credential") from exc
+
+    if info.get("aud") != settings.google_client_id:
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Invalid Google credential")
+    email = (info.get("email") or "").lower()
+    if not email or info.get("email_verified") not in (True, "true", "True"):
+        raise HTTPException(status_code=status.HTTP_401_UNAUTHORIZED, detail="Google account email not verified")
+
+    name = (info.get("name") or "").strip() or email.split("@")[0]
+
+    result = await session.execute(select(User).where(User.email == email))
+    user = result.scalar_one_or_none()
+    if user is None:
+        user = User(
+            full_name=name,
+            phone=None,
+            email=email,
+            password_hash=hash_password(token_urlsafe(32)),  # passwordless; login is via Google
+            role=UserRole.CUSTOMER,
+        )
+        session.add(user)
+        await session.flush()
+        session.add(AuditLog(actor_id=user.id, action="google_signup", entity_type="user", entity_id=str(user.id)))
+        await session.commit()
+        await session.refresh(user)
+    elif not user.is_active:
+        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Account is disabled")
+
+    session.add(AuditLog(actor_id=user.id, action="google_login", entity_type="user", entity_id=str(user.id)))
+    return await issue_tokens(session, user, settings)
+
+
+async def update_profile(session: AsyncSession, user: User, payload: ProfileUpdateRequest) -> User:
+    if payload.full_name is not None:
+        user.full_name = payload.full_name
+    if payload.phone is not None:
+        existing = await session.scalar(
+            select(User).where(User.phone == payload.phone, User.id != user.id)
+        )
+        if existing:
+            raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="Phone number already in use")
+        user.phone = payload.phone
+    session.add(AuditLog(actor_id=user.id, action="profile_updated", entity_type="user", entity_id=str(user.id)))
+    await session.commit()
+    await session.refresh(user)
+    return user
+
+
