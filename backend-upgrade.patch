@@ -0,0 +1,80 @@
+"""Staff management and order-assignment business logic.
+
+The capacity rule for this business is "we send staff according to work", so an
+order can carry any number of staff. The only hard constraint is that a single
+staff member cannot be dispatched to two jobs at the same time — enforced here
+as a conflict on (scheduled_date, scheduled_slot).
+"""
+
+from uuid import UUID
+
+from fastapi import HTTPException, status
+from sqlalchemy import select
+from sqlalchemy.ext.asyncio import AsyncSession
+
+from app.models.order import Order, OrderStatus
+from app.models.staff import OrderAssignment, StaffMember
+
+
+async def get_staff_or_404(session: AsyncSession, staff_id: UUID) -> StaffMember:
+    staff = await session.get(StaffMember, staff_id)
+    if not staff:
+        raise HTTPException(status_code=404, detail="Staff member not found")
+    return staff
+
+
+async def _busy_order_ids(session: AsyncSession, staff_id: UUID, date, slot: str) -> list[UUID]:
+    """Return the ids of active orders this staff member is already on for the
+    same date and slot (the double-booking check)."""
+
+    stmt = (
+        select(Order.id)
+        .join(OrderAssignment, OrderAssignment.order_id == Order.id)
+        .where(
+            OrderAssignment.staff_id == staff_id,
+            Order.scheduled_date == date,
+            Order.scheduled_slot == slot,
+            Order.status.notin_([OrderStatus.CANCELLED, OrderStatus.COMPLETED]),
+        )
+    )
+    return list((await session.scalars(stmt)).all())
+
+
+async def assert_staff_available(
+    session: AsyncSession, staff_id: UUID, date, slot: str, ignore_order_id: UUID | None = None
+) -> None:
+    busy = await _busy_order_ids(session, staff_id, date, slot)
+    busy = [o for o in busy if o != ignore_order_id]
+    if busy:
+        raise HTTPException(
+            status_code=status.HTTP_409_CONFLICT,
+            detail="This staff member is already assigned to another job at the same time.",
+        )
+
+
+async def assign_staff(
+    session: AsyncSession,
+    order: Order,
+    staff_ids: list[UUID],
+    actor_id: UUID | None = None,
+) -> list[StaffMember]:
+    """Assign one or more staff to an order, rejecting double-bookings."""
+
+    assigned: list[StaffMember] = []
+    for staff_id in staff_ids:
+        staff = await get_staff_or_404(session, staff_id)
+        if not staff.is_active:
+            raise HTTPException(status_code=400, detail=f"{staff.full_name} is inactive.")
+        await assert_staff_available(session, staff_id, order.scheduled_date, order.scheduled_slot)
+        existing = await session.scalar(
+            select(OrderAssignment).where(
+                OrderAssignment.order_id == order.id, OrderAssignment.staff_id == staff_id
+            )
+        )
+        if not existing:
+            session.add(
+                OrderAssignment(order_id=order.id, staff_id=staff_id, assigned_by=actor_id)
+            )
+        assigned.append(staff)
+    await session.flush()
+    return assigned
