+from typing import Annotated
+from uuid import UUID
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+
+from app.api.deps import DbSession, require_admin, require_operations
+from app.core.security import hash_password
+from app.models.user import AuditLog, User, UserRole
+from app.schemas.admin import (
+    AdminCreateUserRequest,
+    AdminResetPasswordRequest,
+    AdminUpdateUserRequest,
+    AdminUserResponse,
+)
+
+admin_router = APIRouter(prefix="/admin", tags=["users"])
+
+
+@admin_router.get("/users", response_model=list[AdminUserResponse])
+async def list_users(
+    session: DbSession, actor: Annotated[User, Depends(require_operations)]
+) -> list[User]:
+    return list((await session.scalars(select(User).order_by(User.created_at.desc()))).all())
+
+
+@admin_router.post("/users", response_model=AdminUserResponse, status_code=status.HTTP_201_CREATED)
+async def create_user(
+    payload: AdminCreateUserRequest,
+    session: DbSession,
+    actor: Annotated[User, Depends(require_admin)],
+) -> User:
+    existing = await session.scalar(
+        select(User).where((User.phone == payload.phone) | (User.email == payload.email))
+    )
+    if existing:
+        raise HTTPException(status_code=409, detail="A user with this phone or email already exists")
+    user = User(
+        full_name=payload.full_name,
+        phone=payload.phone,
+        email=payload.email.lower() if payload.email else None,
+        password_hash=hash_password(payload.password),
+        role=payload.role,
+    )
+    session.add(user)
+    await session.flush()
+    session.add(AuditLog(actor_id=actor.id, action="user_created", entity_type="user", entity_id=str(user.id)))
+    await session.commit()
+    await session.refresh(user)
+    return user
+
+
+@admin_router.patch("/users/{user_id}", response_model=AdminUserResponse)
+async def update_user(
+    user_id: UUID,
+    payload: AdminUpdateUserRequest,
+    session: DbSession,
+    actor: Annotated[User, Depends(require_admin)],
+) -> User:
+    user = await session.get(User, user_id)
+    if not user:
+        raise HTTPException(status_code=404, detail="User not found")
+    if user.id == actor.id and payload.is_active is False:
+        raise HTTPException(status_code=400, detail="You cannot deactivate your own account")
+    data = payload.model_dump(exclude_unset=True)
+    if "role" in data and data["role"] == UserRole.OWNER and actor.role != UserRole.OWNER:
+        raise HTTPException(status_code=403, detail="Only the owner can grant the OWNER role")
+    for name, value in data.items():
+        setattr(user, name, value)
+    session.add(AuditLog(actor_id=actor.id, action="user_updated", entity_type="user", entity_id=str(user.id)))
+    await session.commit()
+    await session.refresh(user)
+    return user
+
+
+@admin_router.post("/users/{user_id}/reset-password", status_code=status.HTTP_204_NO_CONTENT)
+async def reset_password(
+    user_id: UUID,
+    payload: AdminResetPasswordRequest,
+    session: DbSession,
+    actor: Annotated[User, Depends(require_admin)],
+) -> None:
+    user = await session.get(User, user_id)
+    if not user:
+        raise HTTPException(status_code=404, detail="User not found")
+    user.password_hash = hash_password(payload.password)
+    session.add(AuditLog(actor_id=actor.id, action="password_reset", entity_type="user", entity_id=str(user.id)))
+    await session.commit()
