+# --------------------------------------------------------------------------- #
+# Reports
+# --------------------------------------------------------------------------- #
+@admin_router.get("/reports", response_model=ReportResponse)
+async def reports(
+    session: DbSession,
+    actor: Annotated[User, Depends(require_operations)],
+    start: Annotated[date | None, Query()] = None,
+    end: Annotated[date | None, Query()] = None,
+) -> ReportResponse:
+    end_date = end or date.today()
+    start_date = start or (end_date - timedelta(days=6))
+
+    orders = list(
+        (
+            await session.scalars(
+                select(Order)
+                .where(Order.scheduled_date >= start_date, Order.scheduled_date <= end_date)
+                .options(selectinload(Order.payments))
+            )
+        ).all()
+    )
+
+    def summarize(day_orders: list[Order]) -> ReportSummary:
+        revenue = Decimal("0")
+        upi = Decimal("0")
+        cash = Decimal("0")
+        completed = 0
+        cancelled = 0
+        for o in day_orders:
+            if o.status == OrderStatus.COMPLETED:
+                completed += 1
+            elif o.status == OrderStatus.CANCELLED:
+                cancelled += 1
+            for p in o.payments:
+                if p.status == "received":
+                    revenue += p.amount
+                    if p.method == PaymentMethod.UPI:
+                        upi += p.amount
+                    else:
+                        cash += p.amount
+        return ReportSummary(
+            orders=len(day_orders),
+            completed=completed,
+            cancelled=cancelled,
+            revenue=revenue,
+            revenue_upi=upi,
+            revenue_cash=cash,
+        )
+
+    buckets: dict[str, list[Order]] = {}
+    for o in orders:
+        buckets.setdefault(o.scheduled_date.isoformat(), []).append(o)
+
+    return ReportResponse(
+        start=start_date,
+        end=end_date,
+        total=summarize(orders),
+        by_day={k: summarize(v) for k, v in buckets.items()},
+    )
+
