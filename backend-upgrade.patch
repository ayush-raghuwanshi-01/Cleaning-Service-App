@@ -0,0 +1,144 @@
+"""Outbound customer notifications (WhatsApp Business Cloud API).
+
+Every send is best-effort and non-blocking: a failure to deliver a message must
+never fail the API request that triggered it. When `notifications_enabled` is
+False (the default) or credentials are missing, sends degrade to a structured
+log line so the app remains safe to run without a provider.
+
+The provider is Meta's WhatsApp Cloud API (Graph API v20.0):
+    POST https://graph.facebook.com/v20.0/{phone_number_id}/messages
+"""
+
+import asyncio
+import logging
+
+import httpx
+import structlog
+
+from app.core.config import get_settings
+from app.models.order import Order
+
+logger = structlog.get_logger(__name__)
+graph_logger = logging.getLogger("notifications")
+
+GRAPH_VERSION = "v20.0"
+GRAPH_URL = f"https://graph.facebook.com/{GRAPH_VERSION}"
+
+
+def _e164(phone: str) -> str:
+    """Normalize a phone number to E.164. Assumes Indian 10-digit numbers."""
+    digits = "".join(ch for ch in phone if ch.isdigit())
+    if digits.startswith("91") and len(digits) == 12:
+        return digits
+    if len(digits) == 10:
+        return "91" + digits
+    return digits
+
+
+def _settings() -> tuple[bool, str | None, str | None]:
+    s = get_settings()
+    return s.notifications_enabled, s.whatsapp_access_token, s.whatsapp_phone_number_id
+
+
+async def send_text(to_phone: str, message: str) -> bool:
+    """Send a free-form text message. Returns True on success."""
+
+    enabled, token, phone_number_id = _settings()
+    if not enabled or not token or not phone_number_id:
+        logger.info("notification.skipped", to=_e164(to_phone), reason="notifications disabled or unconfigured")
+        return False
+
+    url = f"{GRAPH_URL}/{phone_number_id}/messages"
+    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
+    payload = {
+        "messaging_product": "whatsapp",
+        "to": _e164(to_phone),
+        "type": "text",
+        "text": {"body": message},
+    }
+    try:
+        async with httpx.AsyncClient(timeout=10) as client:
+            resp = await client.post(url, headers=headers, json=payload)
+        resp.raise_for_status()
+        logger.info("notification.sent", to=_e164(to_phone))
+        return True
+    except httpx.HTTPError as exc:  # network or 4xx/5xx
+        logger.warning("notification.failed", to=_e164(to_phone), error=str(exc))
+        return False
+
+
+# --------------------------------------------------------------------------- #
+# Message templates
+# --------------------------------------------------------------------------- #
+def customer_messages(order: Order, event: str) -> str | None:
+    brand = "Home Shine"
+    name = order.customer_name.split(" ")[0]
+    service = order.service_name
+    code = order.order_code
+    slot = order.scheduled_slot
+
+    if event == "order_created":
+        return (
+            f"Hi {name}, thanks for booking *{service}* with {brand}. "
+            f"We'll call you shortly to confirm your slot. Your booking code is {code}."
+        )
+    if event == "confirmed":
+        return (
+            f"Hi {name}, your {brand} booking *{code}* for {service} on "
+            f"{order.scheduled_date} ({slot}) is confirmed. We'll see you then!"
+        )
+    if event == "in_progress":
+        return f"Hi {name}, our team is on the way for your {service} appointment ({slot})."
+    if event == "completed":
+        return (
+            f"Hi {name}, your {service} with {brand} is complete. "
+            f"Thank you for choosing us — we'd love your feedback!"
+        )
+    if event == "payment_received":
+        received = sum((p.amount for p in order.payments if p.status == "received"), 0)
+        return f"Hi {name}, payment of ₹{received} received for booking {code}. Thank you!"
+    return None
+
+
+def admin_message(order: Order) -> str:
+    return (
+        f"🆕 New website order *{order.order_code}*\n"
+        f"{order.service_name}\n"
+        f"👤 {order.customer_name} ({order.customer_phone})\n"
+        f"📅 {order.scheduled_date} · {order.scheduled_slot}\n"
+        f"📍 {order.street}, {order.area}, {order.pincode}"
+    )
+
+
+# --------------------------------------------------------------------------- #
+# Fire-and-forget dispatcher
+# --------------------------------------------------------------------------- #
+def _dispatch(coros: list) -> None:
+    async def run_all():
+        await asyncio.gather(*coros, return_exceptions=True)
+
+    try:
+        loop = asyncio.get_running_loop()
+        loop.create_task(run_all())
+    except RuntimeError:
+        # No running loop (e.g. some test harnesses) — just drop the message.
+        logger.info("notification.dropped", reason="no event loop")
+
+
+def notify_order_event(order: Order, event: str) -> None:
+    """Notify the customer about an order event (best-effort)."""
+
+    message = customer_messages(order, event)
+    if not message:
+        return
+    _dispatch([send_text(order.customer_phone, message)])
+
+
+def notify_new_order_admin(order: Order) -> None:
+    """Alert the internal admin number when a website order comes in."""
+
+    admin_number = get_settings().whatsapp_admin_number
+    if not admin_number:
+        logger.info("notification.admin_skipped", reason="whatsapp_admin_number not set")
+        return
+    _dispatch([send_text(admin_number, admin_message(order))])
