new file mode 100644
index 0000000000000000000000000000000000000000..e55aa935f85462bb9e6650e354f28de1e0413f24
--- /dev/null
+++ b/app/api/v1/endpoints/staff.py
@@ -0,0 +1,64 @@
+from typing import Annotated
+from uuid import UUID
+
+from fastapi import APIRouter, Depends, HTTPException, status
+from sqlalchemy import select
+
+from app.api.deps import DbSession, require_operations
+from app.models.staff import StaffMember
+from app.models.user import AuditLog, User
+from app.schemas.staff import StaffMemberInput, StaffMemberResponse
+
+admin_router = APIRouter(prefix="/admin", tags=["staff"])
+
+
+@admin_router.get("/staff", response_model=list[StaffMemberResponse])
+async def list_staff(
+    session: DbSession, actor: Annotated[User, Depends(require_operations)]
+) -> list[StaffMember]:
+    return list((await session.scalars(select(StaffMember).order_by(StaffMember.full_name))).all())
+
+
+@admin_router.post("/staff", response_model=StaffMemberResponse, status_code=status.HTTP_201_CREATED)
+async def create_staff(
+    payload: StaffMemberInput, session: DbSession, actor: Annotated[User, Depends(require_operations)]
+) -> StaffMember:
+    existing = await session.scalar(select(StaffMember).where(StaffMember.phone == payload.phone))
+    if existing:
+        raise HTTPException(status_code=409, detail="A staff member with this phone already exists")
+    staff = StaffMember(**payload.model_dump())
+    session.add(staff)
+    session.add(AuditLog(actor_id=actor.id, action="staff_created", entity_type="staff", entity_id=str(staff.id)))
+    await session.commit()
+    await session.refresh(staff)
+    return staff
+
+
+@admin_router.patch("/staff/{staff_id}", response_model=StaffMemberResponse)
+async def update_staff(
+    staff_id: UUID,
+    payload: StaffMemberInput,
+    session: DbSession,
+    actor: Annotated[User, Depends(require_operations)],
+) -> StaffMember:
+    staff = await session.get(StaffMember, staff_id)
+    if not staff:
+        raise HTTPException(status_code=404, detail="Staff member not found")
+    for name, value in payload.model_dump().items():
+        setattr(staff, name, value)
+    session.add(AuditLog(actor_id=actor.id, action="staff_updated", entity_type="staff", entity_id=str(staff.id)))
+    await session.commit()
+    await session.refresh(staff)
+    return staff
+
+
+@admin_router.delete("/staff/{staff_id}", status_code=status.HTTP_204_NO_CONTENT)
+async def delete_staff(
+    staff_id: UUID, session: DbSession, actor: Annotated[User, Depends(require_operations)]
+) -> None:
+    staff = await session.get(StaffMember, staff_id)
+    if not staff:
+        raise HTTPException(status_code=404, detail="Staff member not found")
+    await session.delete(staff)
+    session.add(AuditLog(actor_id=actor.id, action="staff_deleted", entity_type="staff", entity_id=str(staff_id)))
+    await session.commit()
