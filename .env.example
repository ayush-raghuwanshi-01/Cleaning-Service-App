# API base URL. Leave empty to use the Vite dev proxy (which forwards /api to
# the backend). Set the full backend URL for production builds.
VITE_API_URL=

# Backend URL used by the Vite dev proxy when VITE_API_URL is empty.
VITE_API_PROXY_TARGET=http://localhost:8000

